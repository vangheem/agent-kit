# Local compose defaults. Override in .env.compose.local.
# Replace APP_SECRET before any shared or deployed use.

DATABASE_URL=postgres://agentkit:agentkit@db:5432/agentkit
APP_SECRET=local-only-agent-kit-secret-change-me
BLOB_STORAGE_TYPE=pg
BLOB_FS_ROOT=/var/lib/agent-kit/blobs
AGENT_KIT_ALLOW_MOCK=true
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
BIND_ADDR=0.0.0.0:7010
CORS_ORIGIN=http://localhost:4210
RUST_LOG=info

POSTGRES_USER=agentkit
POSTGRES_PASSWORD=agentkit
POSTGRES_DB=agentkit

VITE_API_URL=http://localhost:7010
NPM_REGISTRY=https://registry.npmjs.org/
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
