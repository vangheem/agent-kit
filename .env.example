# Copy to .env for host-side `agent-kit migrate` and `agent-kit serve`.
# Host Postgres is published on 5433. Compose uses
# postgres://agentkit:agentkit@db:5432/agentkit inside the app container.
# Replace APP_SECRET before any shared or deployed use.

DATABASE_URL=postgres://agentkit:agentkit@localhost:5433/agentkit
APP_SECRET=local-only-agent-kit-secret-change-me
BLOB_STORAGE_TYPE=pg
BLOB_FS_ROOT=/var/lib/agent-kit/blobs
AGENT_KIT_ALLOW_MOCK=false
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
BIND_ADDR=0.0.0.0:7010
CORS_ORIGIN=http://localhost:4210
RUST_LOG=info
