{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4210 --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4210 --host 0.0.0.0",
    "format": "prettier --write ./src vite.config.ts eslint.config.js",
    "lint": "prettier --check ./src vite.config.ts eslint.config.js && eslint ./src",
    "test": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.0",
    "@mdi/js": "^7.4.0",
    "@mdi/react": "^1.6.0",
    "@mui/material": "^6.4.12",
    "@tanstack/react-query": "5.101.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.0",
    "@types/node": "~25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-unused-imports": "^4.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.0"
  }
}
